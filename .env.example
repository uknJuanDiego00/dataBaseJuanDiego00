# Base de datos principal
DATABASE_URL=postgresql+psycopg://postgres:contrasena@localhost:5432/biblioteca
# Base de datos exclusiva para pruebas automatizadas
TEST_DATABASE_URL=postgresql+psycopg://postgres:contrasena@localhost:5432/biblioteca_test

# Seguridad y JWT (SECRET_KEY mínimo 32 caracteres, usar openssl rand -hex 32)
SECRET_KEY=cambiar_por_una_clave_hex_segura_de_minimo_32_caracteres_ej_openssl_rand
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (lista JSON o separada por comas)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000"]

# Entorno: development | test | production
ENVIRONMENT=development
